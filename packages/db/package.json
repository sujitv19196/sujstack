{
  "name": "@app/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "bun --env-file=../../apps/next/.env.local drizzle-kit migrate",
    "db:push": "bun --env-file=../../apps/next/.env.local drizzle-kit push",
    "db:studio": "bun --env-file=../../apps/next/.env.local drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "0.31.10"
  }
}
