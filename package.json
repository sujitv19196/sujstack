{
  "name": "sujstack",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "kit/ports/*",
    "kit/adapters/*"
  ],
  "scripts": {
    "dev": "bun run --filter @sujstack/next dev",
    "worker": "bun run --filter @sujstack/worker dev",
    "build": "bun run --filter @sujstack/next build",
    "start": "bun run --filter @sujstack/next start",
    "typecheck": "bun run --filter '*' typecheck",
    "check": "biome check . && bun run --cwd kit check",
    "check:fix": "biome check --write . && bun run --cwd kit check:fix",
    "format": "biome format --write . && bun run --cwd kit format",
    "test": "bun test",
    "db:generate": "bun run --filter @sujstack/next db:generate",
    "db:check": "bun run --filter @sujstack/next db:check",
    "db:migrate": "bun run --filter @sujstack/next db:migrate",
    "db:push": "bun run --filter @sujstack/next db:push",
    "db:studio": "bun run --filter @sujstack/next db:studio",
    "metrics:rules": "bun run --filter @sujstack/next metrics:rules",
    "metrics:check": "bun run --filter @sujstack/next metrics:check",
    "infra:fmt": "terraform -chdir=infra fmt -recursive",
    "infra:check": "terraform -chdir=infra fmt -check -recursive && terraform -chdir=infra init -backend=false -input=false >/dev/null && terraform -chdir=infra validate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/bun": "latest",
    "typescript": "7.0.2"
  }
}
