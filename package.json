{
  "name": "sujstack",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "lib/*"
  ],
  "scripts": {
    "dev": "bun run --filter @sujstack/next dev",
    "build": "bun run --filter @sujstack/next build",
    "start": "bun run --filter @sujstack/next start",
    "typecheck": "bun run --filter '*' typecheck",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "bun test",
    "db:generate": "bun run --filter @sujstack/db db:generate",
    "db:check": "bun run --filter @sujstack/db db:check",
    "db:migrate": "bun run --filter @sujstack/db db:migrate",
    "db:push": "bun run --filter @sujstack/db db:push",
    "db:studio": "bun run --filter @sujstack/db db:studio"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/bun": "latest",
    "typescript": "7.0.2"
  }
}
