# Secrets and per-deployment values only. Adapter selection, vector dimensions
# and distance metric are configured in code, at apps/db/src/runtime.ts.

# Unset by default; the first query throws, not module import.
# DATABASE_URL="postgresql://user:password@localhost:5432/app"

# Unset by default; the Sentry SDK stays inert without a DSN.
# SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
# NEXT_PUBLIC_SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
