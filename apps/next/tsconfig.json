{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "bun"],
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] },
    "incremental": true
  },
  "include": [
    "src",
    "scripts",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "next.config.ts",
    "drizzle.config.ts"
  ],
  "exclude": ["node_modules"]
}
