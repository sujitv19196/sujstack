{
  "name": "@sujstack/metrics",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./adapters/*": "./src/adapters/*.ts",
    "./runtime": "./src/runtime.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "metrics:rules": "bun scripts/rules.ts",
    "metrics:check": "bun scripts/rules.ts --check"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@sujstack/metrics-core": "workspace:*"
  }
}
