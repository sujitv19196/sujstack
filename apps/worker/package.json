    "@sujstack/next": "workspace:*",
    "@sujstack/obs-adapters": "workspace:*",
    "@sujstack/obs-core": "workspace:*",
    "express": "5.2.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "5.0.6"
  }
}
